# Authentik deployment env. Copy to .env and fill in real secrets.
# Generate:  PG_PASS=$(openssl rand -base64 36)  AUTHENTIK_SECRET_KEY=$(openssl rand -base64 60)

AUTHENTIK_TAG=2026.8.2

PG_DB=authentik
PG_USER=authentik
PG_PASS=replace-me

AUTHENTIK_SECRET_KEY=replace-me

# Host ports published for the Authentik web UI and OIDC endpoints.
# The browser must be able to reach COMPOSE_PORT_HTTP externally, since the
# OIDC authorize redirect happens client-side.
COMPOSE_PORT_HTTP=9000
COMPOSE_PORT_HTTPS=9443

# Privacy: disable telemetry and update checks.
AUTHENTIK_ERROR_REPORTING__ENABLED=false
AUTHENTIK_DISABLE_UPDATE_CHECK=true
